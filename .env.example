# Copiază acest fișier în `.env` și înlocuiește valorile false.
# `.env` NU intră niciodată în Git. În producție variabilele se pun doar în Coolify.

# --- Baza de date (dezvoltare locală, docker-compose.yml) ---
POSTGRES_PASSWORD=schimba-ma-parola-lunga
# Contul proprietar: doar pentru migrări (npm run db:migrate) și pentru teste.
MIGRATION_DATABASE_URL=postgres://app:schimba-ma-parola-lunga@127.0.0.1:5432/servicerotirapid
# Contul aplicației (app_user): fără drept de a ocoli Row-Level Security. Îl creează `npm run db:migrate`.
APP_DB_PASSWORD=alta-parola-lunga-pentru-aplicatie
DATABASE_URL=postgres://app_user:alta-parola-lunga-pentru-aplicatie@127.0.0.1:5432/servicerotirapid
# Baza folosită doar de testele automate (numele trebuie să se termine în _test). Cu contul proprietar.
TEST_DATABASE_URL=postgres://app:schimba-ma-parola-lunga@127.0.0.1:5432/servicerotirapid_test
# Opțional: câte conexiuni simultane la baza de date (implicit 10).
# DATABASE_POOL_MAX=10

# --- Aplicația ---
# Adresa publică, fără / la final. Se folosește în linkurile din SMS și la autentificare.
APP_BASE_URL=http://localhost:3000
# Cheia secretă pentru sesiunile de logare. Minim 32 de caractere aleatorii.
AUTH_SECRET=schimba-ma-cu-o-cheie-lunga-si-aleatorie-pentru-sesiuni
# Cheia secretă cu care se generează linkurile „vezi / anulează programarea”.
# Minim 32 de caractere aleatorii. Dacă se schimbă, linkurile vechi nu mai merg.
BOOKING_LINK_SECRET=schimba-ma-cu-o-cheie-lunga-si-aleatorie

# --- Vin în fazele următoare ---
# Faza 6: Cloudflare Turnstile (anti-spam).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
