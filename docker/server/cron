# Task-uri programate pentru servicerotirapid. Se copiază în /etc/cron.d/servicerotirapid.
# Ora serverului e UTC: 02:00 UTC = 04:00 sau 05:00 în România.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Ștergerea datelor vechi (GDPR)
0 2 * * * root docker exec servicerotirapid-ops-1 retention.sh >> /var/log/servicerotirapid.log 2>&1
# Backup criptat
30 2 * * * root docker exec servicerotirapid-ops-1 backup.sh >> /var/log/servicerotirapid.log 2>&1
